{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My PC Kit",
  "mainBinaryName": "MyPCKit",
  "version": "1.2.0",
  "identifier": "com.isado.mypckit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "My PC Kit",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Isado (Nguyễn Thiện Đức)",
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxODUzNzlGNjdDN0NBQTgKUldTb3lzZG5uemVGWVhVb0Rtd1NySnpQWFR1Y0x2YnhkVGZBdjZGdXNyT3cyZWd5L0hYWTZtNjEK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
